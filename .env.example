# ===================================
# REQUIRED ENVIRONMENT VARIABLES
# ===================================
# These MUST be set for the app to work

# Server Configuration
NODE_ENV=production
PORT=5000

# Frontend URL (for CORS) - REQUIRED
# Set this to your deployed frontend URL on Vercel
FRONTEND_URL=https://your-frontend-app.vercel.app

# JWT Configuration - REQUIRED
# Generate a strong secret (at least 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Database Configuration - REQUIRED
# MongoDB Atlas connection string (required for Vercel)
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ballot-app?retryWrites=true&w=majority

# ===================================
# USER AUTHENTICATION
# ===================================
# Uses email & password. Only @student.babcock.edu.ng emails allowed.
# Users must be in the valid voters list (admin uploads via valid-voters) to register.

# ===================================
# OPTIONAL CONFIGURATION
# ===================================

# Rate Limiting (optional overrides)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# ===================================
# VERCEL DEPLOYMENT NOTES
# ===================================
# 1. Add all REQUIRED variables to Vercel environment variables
# 2. Ensure MONGODB_URI uses MongoDB Atlas (not localhost)
# 3. Set FRONTEND_URL to your Vercel frontend URL
# 4. Generate a strong JWT_SECRET (minimum 32 characters)
