{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [{"src": "index.js", "use": "@vercel/node"}],
  "routes": [{"src": "/(.*)", "dest": "index.js", "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]}],
  "env": {"NODE_ENV": "production"},
  "functions": {"index.js": {"maxDuration": 30, "memory": 1024}},
  "regions": ["iad1"]
}
